import eu.kanade.tachiyomi.animesource.model.AnimeUpdateStrategy;
import eu.kanade.tachiyomi.animesource.model.FetchType;
import kotlin.Boolean;
import kotlin.String;
import kotlin.collections.List;

CREATE TABLE anime(
    id INTEGER NOT NULL PRIMARY KEY,
    source_id INTEGER NOT NULL,
    remote_url TEXT NOT NULL,
    remote_artist TEXT,
    remote_author TEXT,
    remote_description TEXT,
    remote_genre TEXT AS List<String>,
    remote_title TEXT NOT NULL,
    remote_status INTEGER NOT NULL,
    remote_cover TEXT,
    favorite INTEGER AS Boolean NOT NULL,
    state_last_update INTEGER,
    state_next_update INTEGER,
    state_initialized INTEGER AS Boolean NOT NULL,
    user_viewer INTEGER NOT NULL,
    user_episode_flags INTEGER NOT NULL,
    state_cover_last_modified INTEGER NOT NULL,
    date_added INTEGER NOT NULL,
    remote_update_strategy INTEGER AS AnimeUpdateStrategy NOT NULL DEFAULT 0,
    state_fetch_interval INTEGER DEFAULT 0 NOT NULL,
    last_modified_at INTEGER NOT NULL DEFAULT 0,
    favorite_modified_at INTEGER,
    version INTEGER NOT NULL DEFAULT 0,
    is_syncing INTEGER NOT NULL DEFAULT 0,
    remote_fetch_type INTEGER AS FetchType NOT NULL DEFAULT 1,
    parent_id INTEGER,
    user_season_flags INTEGER NOT NULL,
    remote_season_number REAL NOT NULL,
    remote_season_source_order INTEGER NOT NULL,
    remote_background TEXT,
    state_background_last_modified INTEGER NOT NULL,
    UNIQUE(source_id, remote_url)
);

CREATE INDEX animelib_favorite_index ON anime(favorite) WHERE favorite = 1;
CREATE INDEX animes_url_index ON anime(remote_url);
CREATE INDEX animes_parent_id ON anime(parent_id);
CREATE INDEX animes_fetch_type ON anime(remote_fetch_type);

CREATE TRIGGER update_last_favorite_at_animes
AFTER UPDATE OF favorite ON anime
BEGIN
  UPDATE anime
  SET favorite_modified_at = strftime('%s', 'now')
  WHERE id = new.id;
END;

CREATE TRIGGER update_last_modified_at_animes
AFTER UPDATE ON anime
FOR EACH ROW
BEGIN
  UPDATE anime
  SET last_modified_at = strftime('%s', 'now')
  WHERE id = new.id;
END;

CREATE TRIGGER update_anime_version AFTER UPDATE ON anime
BEGIN
    UPDATE anime SET version = version + 1
    WHERE id = new.id AND new.is_syncing = 0 AND (
        new.remote_url != old.remote_url OR
        new.remote_description != old.remote_description OR
        new.favorite != old.favorite
    );
END;

getAnimeById:
SELECT *
FROM anime
WHERE id = :id;

getAnimeByUrlAndSource:
SELECT *
FROM anime
WHERE remote_url = :url AND source_id = :source
;

getFavorites:
SELECT *
FROM anime
WHERE favorite = 1;

getWatchedAnimeNotInLibrary:
SELECT *
FROM anime
WHERE favorite = 0 AND id IN (
    SELECT DISTINCT episode.anime_id
    FROM episode
    WHERE user_seen = 1 OR user_last_second_seen != 0
);

getBackupAnimeBatch:
SELECT *
FROM anime
WHERE id > :afterId AND id <= :upToId
AND (favorite = 1 OR (:includeReadEntries = 1 AND EXISTS (
    SELECT 1 FROM episode
    WHERE anime_id = anime.id AND (
        user_seen = 1 OR user_last_second_seen != 0 OR EXISTS (
            SELECT 1 FROM anime_history WHERE episode_id = episode.id
        )
    )
)))
ORDER BY id
LIMIT :limit;

getAllAnime:
SELECT *
FROM anime;

getAllAnimeSourceAndUrl:
SELECT source_id AS source, remote_url AS url
FROM anime;

getAnimesWithFavoriteTimestamp:
SELECT *
FROM anime
WHERE favorite_modified_at IS NOT NULL;

getAnimeSourceIdWithFavoriteCount:
SELECT
source_id,
count(*)
FROM anime
WHERE favorite = 1
GROUP BY source_id;

getFavoriteBySourceId:
SELECT *
FROM anime
WHERE favorite = 1
AND source_id = :sourceId;

getDuplicateLibraryAnime:
SELECT *
FROM anime
WHERE favorite = 1
AND LOWER(remote_title) = :title
AND id != :id;

getUpcomingAnime:
SELECT *
FROM anime
WHERE state_next_update >= :startOfDay
AND favorite = 1
AND remote_status IN :statuses
ORDER BY state_next_update ASC;

resetViewerFlags:
UPDATE anime
SET user_viewer = 0;

resetIsSyncing:
UPDATE anime
SET is_syncing = 0
WHERE is_syncing = 1;

removeParentIdByIds:
UPDATE anime
SET parent_id = NULL
WHERE id IN :animeIds;

getChildrenByParentId:
SELECT *
FROM anime
WHERE parent_id = :parentId;

deleteAnimesNotInLibraryByAnimeIds:
DELETE FROM anime
WHERE favorite = 0 AND id IN :animeIds;

insert:
INSERT INTO anime(source_id, remote_url, remote_artist, remote_author, remote_description, remote_genre, remote_title, remote_status, remote_cover, favorite, state_last_update, state_next_update, state_initialized, user_viewer, user_episode_flags, state_cover_last_modified, date_added, remote_update_strategy, state_fetch_interval, last_modified_at, version, remote_fetch_type, parent_id, user_season_flags, remote_season_number, remote_season_source_order, remote_background, state_background_last_modified)
VALUES (:source, :url, :artist, :author, :description, :genre, :title, :status, :thumbnailUrl, :favorite, :lastUpdate, :nextUpdate, :initialized, :viewerFlags, :episodeFlags, :coverLastModified,:dateAdded, :updateStrategy, :calculateInterval, 0, :version, :fetchType, :parentId, :seasonFlags, :seasonNumber, :seasonSourceOrder, :backgroundUrl, :backgroundLastModified)
ON CONFLICT(source_id, remote_url) DO NOTHING;

update:
UPDATE anime SET
    source_id = coalesce(:source, source_id),
    remote_url = coalesce(:url, remote_url),
    remote_artist = coalesce(:artist, remote_artist),
    remote_author = coalesce(:author, remote_author),
    remote_description = coalesce(:description, remote_description),
    remote_genre = coalesce(:genre, remote_genre),
    remote_title = coalesce(:title, remote_title),
    remote_status = coalesce(:status, remote_status),
    remote_cover = coalesce(:thumbnailUrl, remote_cover),
    favorite = coalesce(:favorite, favorite),
    state_last_update = coalesce(:lastUpdate, state_last_update),
    state_next_update = coalesce(:nextUpdate, state_next_update),
    state_initialized = coalesce(:initialized, state_initialized),
    user_viewer = coalesce(:viewer, user_viewer),
    user_episode_flags = coalesce(:episodeFlags, user_episode_flags),
    state_cover_last_modified = coalesce(:coverLastModified, state_cover_last_modified),
    date_added = coalesce(:dateAdded, date_added),
    remote_update_strategy = coalesce(:updateStrategy, remote_update_strategy),
    state_fetch_interval = coalesce(:calculateInterval, state_fetch_interval),
    version = coalesce(:version, version),
    is_syncing = coalesce(:isSyncing, is_syncing),
    remote_fetch_type = coalesce(:fetchType, remote_fetch_type),
    parent_id = coalesce(:parentId, parent_id),
    user_season_flags = coalesce(:seasonFlags, user_season_flags),
    remote_season_number = coalesce(:seasonNumber, remote_season_number),
    remote_season_source_order = coalesce(:seasonSourceOrder, remote_season_source_order),
    remote_background = coalesce(:backgroundUrl, remote_background),
    state_background_last_modified = coalesce(:backgroundLastModified, state_background_last_modified)
WHERE id = :animeId;

selectLastInsertedRowId:
SELECT last_insert_rowid();
getMaxAnimeId:
SELECT coalesce(max(id), 0) FROM anime;

getExistingId:
SELECT id FROM anime
WHERE source_id = :source AND remote_url = :url;
