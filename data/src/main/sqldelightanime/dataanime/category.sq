CREATE TABLE category(
    id INTEGER NOT NULL PRIMARY KEY,
    name TEXT NOT NULL,
    sort INTEGER NOT NULL,
    flags INTEGER NOT NULL,
    hidden INTEGER NOT NULL DEFAULT 0
);

-- Insert system category
INSERT OR IGNORE INTO category(id, name, sort, flags) VALUES (0, "", -1, 0);
-- Disallow deletion of default category
CREATE TRIGGER IF NOT EXISTS system_category_delete_trigger BEFORE DELETE
ON category
BEGIN SELECT CASE
    WHEN old.id <= 0 THEN
        RAISE(ABORT, "System category can't be deleted")
    END;
END;

getCategory:
SELECT *
FROM category
WHERE id = :id
LIMIT 1;

getCategories:
SELECT
id AS id,
name,
sort AS `order`,
flags,
hidden
FROM category
ORDER BY sort;

getVisibleCategories:
SELECT
id AS id,
name,
sort AS `order`,
flags,
hidden
FROM category
WHERE hidden = 0
ORDER BY sort;

getCategoriesByAnimeId:
SELECT
C.id AS id,
C.name,
C.sort AS `order`,
C.flags,
C.hidden
FROM category C
JOIN anime_category AC
ON C.id = AC.category_id
WHERE AC.anime_id = :animeId;

getVisibleCategoriesByAnimeId:
SELECT
C.id AS id,
C.name,
C.sort AS `order`,
C.flags,
C.hidden
FROM category C
JOIN anime_category AC
ON C.id = AC.category_id
WHERE AC.anime_id = :animeId AND C.hidden = 0;

insert:
INSERT INTO category(name, sort, flags)
VALUES (:name, :order, :flags);

delete:
DELETE FROM category
WHERE id = :categoryId;

update:
UPDATE category
SET name = coalesce(:name, name),
    sort = coalesce(:order, sort),
    flags = coalesce(:flags, flags),
    hidden = coalesce(:hidden, hidden)
WHERE id = :categoryId;

updateAllFlags:
UPDATE category SET
flags = coalesce(?, flags);

selectLastInsertedRowId:
SELECT last_insert_rowid();

getCategoryOrdersByAnimeIds:
SELECT MC.anime_id, C.sort
FROM category C
JOIN anime_category MC ON C.id = MC.category_id
WHERE MC.anime_id IN :animeIds;
