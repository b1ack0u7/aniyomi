CREATE TABLE anime_category(
    id INTEGER NOT NULL PRIMARY KEY,
    anime_id INTEGER NOT NULL,
    category_id INTEGER NOT NULL,
    UNIQUE(anime_id, category_id),
    FOREIGN KEY(category_id) REFERENCES category (id)
    ON DELETE CASCADE,
    FOREIGN KEY(anime_id) REFERENCES anime (id)
    ON DELETE CASCADE
);

CREATE TRIGGER insert_anime_category_update_version AFTER INSERT ON anime_category
BEGIN
    UPDATE anime
    SET version = version + 1
    WHERE id = new.anime_id AND (SELECT is_syncing FROM anime WHERE id = new.anime_id) = 0;
END;

insert:
INSERT INTO anime_category(anime_id, category_id)
VALUES (:animeId, :categoryId)
ON CONFLICT(anime_id, category_id) DO NOTHING;

deleteAnimeCategoryByAnimeId:
DELETE FROM anime_category
WHERE anime_id = :animeId;