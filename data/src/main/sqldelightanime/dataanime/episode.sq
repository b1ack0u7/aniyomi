import kotlin.Boolean;

CREATE TABLE episode(
    id INTEGER NOT NULL PRIMARY KEY,
    anime_id INTEGER NOT NULL,
    remote_url TEXT NOT NULL,
    remote_name TEXT NOT NULL,
    remote_scanlator TEXT,
    user_seen INTEGER AS Boolean NOT NULL,
    user_bookmark INTEGER AS Boolean NOT NULL,
    user_last_second_seen INTEGER NOT NULL,
    remote_total_seconds INTEGER NOT NULL,
    remote_episode_number REAL NOT NULL,
    remote_source_order INTEGER NOT NULL,
    state_date_fetch INTEGER NOT NULL,
    remote_date_upload INTEGER NOT NULL,
    last_modified_at INTEGER NOT NULL DEFAULT 0,
    version INTEGER NOT NULL DEFAULT 0,
    is_syncing INTEGER NOT NULL DEFAULT 0,
    remote_summary TEXT,
    remote_preview TEXT,
    user_fillermark INTEGER AS Boolean NOT NULL,
    UNIQUE(anime_id, remote_url),
    FOREIGN KEY(anime_id) REFERENCES anime (id)
    ON DELETE CASCADE
);

CREATE INDEX episodes_anime_id_index ON episode(anime_id);
CREATE INDEX episodes_unseen_by_anime_index ON episode(anime_id, user_seen) WHERE user_seen = 0;

CREATE TRIGGER update_last_modified_at_episodes
AFTER UPDATE ON episode
FOR EACH ROW
BEGIN
  UPDATE episode
  SET last_modified_at = strftime('%s', 'now')
  WHERE id = new.id;
END;

CREATE TRIGGER update_episode_and_anime_version AFTER UPDATE ON episode
WHEN new.is_syncing = 0 AND (
    new.user_seen != old.user_seen OR
    new.user_bookmark != old.user_bookmark OR
    new.user_last_second_seen != old.user_last_second_seen
)
BEGIN
    -- Update the episode version
    UPDATE episode SET version = version + 1
    WHERE id = new.id;

    -- Update the anime version
    UPDATE anime SET version = version + 1
    WHERE id = new.anime_id AND (SELECT is_syncing FROM anime WHERE id = new.anime_id) = 0;
END;

CREATE INDEX episode_fetch_date_index ON episode(state_date_fetch DESC);

getEpisodeById:
SELECT *
FROM episode
WHERE id = :id;

getEpisodesByAnimeId:
SELECT *
FROM episode
WHERE anime_id = :animeId;

getBookmarkedEpisodesByAnimeId:
SELECT *
FROM episode
WHERE user_bookmark
AND anime_id = :animeId;


getEpisodeByUrl:
SELECT *
FROM episode
WHERE remote_url = :episodeUrl;

getEpisodeByUrlAndAnimeId:
SELECT *
FROM episode
WHERE remote_url = :episodeUrl
AND anime_id = :animeId;

removeEpisodesWithIds:
DELETE FROM episode
WHERE id IN :episodeIds;

resetIsSyncing:
UPDATE episode
SET is_syncing = 0
WHERE is_syncing = 1;

insert:
INSERT INTO episode(anime_id, remote_url, remote_name, remote_scanlator, user_seen, user_bookmark, user_last_second_seen, remote_total_seconds, remote_episode_number, remote_source_order, state_date_fetch, remote_date_upload, last_modified_at, version, is_syncing, remote_summary, remote_preview, user_fillermark)
VALUES (:animeId, :url, :name, :scanlator, :seen, :bookmark, :lastSecondSeen, :totalSeconds, :episodeNumber, :sourceOrder, :dateFetch, :dateUpload, 0, :version, 0, :summary, :previewUrl, :fillermark)
ON CONFLICT(anime_id, remote_url) DO NOTHING;

update:
UPDATE episode
SET anime_id = coalesce(:animeId, anime_id),
    remote_url = coalesce(:url, remote_url),
    remote_name = coalesce(:name, remote_name),
    remote_scanlator = coalesce(:scanlator, remote_scanlator),
    user_seen = coalesce(:seen, user_seen),
    user_bookmark = coalesce(:bookmark, user_bookmark),
    user_last_second_seen = coalesce(:lastSecondSeen, user_last_second_seen),
    remote_total_seconds = coalesce(:totalSeconds, remote_total_seconds),
    remote_episode_number = coalesce(:episodeNumber, remote_episode_number),
    remote_source_order = coalesce(:sourceOrder, remote_source_order),
    state_date_fetch = coalesce(:dateFetch, state_date_fetch),
    remote_date_upload = coalesce(:dateUpload, remote_date_upload),
    version = coalesce(:version, version),
    is_syncing = coalesce(:isSyncing, is_syncing),
    remote_summary = coalesce(:summary, remote_summary),
    remote_preview = coalesce(:previewUrl, remote_preview),
    user_fillermark = coalesce(:fillermark, user_fillermark)
WHERE id = :episodeId;

selectLastInsertedRowId:
SELECT last_insert_rowid();

getEpisodesByAnimeIds:
SELECT * FROM episode
WHERE anime_id IN :animeIds;

getExistingId:
SELECT id FROM episode
WHERE anime_id = :titleId AND remote_url = :url;
