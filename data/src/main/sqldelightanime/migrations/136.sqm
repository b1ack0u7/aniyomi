-- Adapted from Mihon #3805/#4022, including a999e49f, 9dbb7148 and ea2b73ad.
-- Copy rows without trusting legacy indexes before rebuilding constraints.

CREATE TEMP TABLE legacy_animes AS SELECT _id, source, url, artist, author, description, genre, title, status, thumbnail_url, favorite, last_update, next_update, initialized, viewer, episode_flags, cover_last_modified, date_added, update_strategy, calculate_interval, last_modified_at, favorite_modified_at, version, is_syncing, fetch_type, parent_id, season_flags, season_number, season_source_order, background_url, background_last_modified FROM animes NOT INDEXED;

CREATE TEMP TABLE legacy_episodes AS SELECT _id, anime_id, url, name, scanlator, seen, bookmark, last_second_seen, total_seconds, episode_number, source_order, date_fetch, date_upload, last_modified_at, version, is_syncing, summary, preview_url, fillermark FROM episodes NOT INDEXED;

CREATE TEMP TABLE legacy_categories AS SELECT _id, name, sort, flags, hidden FROM categories NOT INDEXED;

CREATE TEMP TABLE legacy_animes_categories AS SELECT _id, anime_id, category_id FROM animes_categories NOT INDEXED;

CREATE TEMP TABLE legacy_anime_sync AS SELECT _id, anime_id, sync_id, remote_id, library_id, title, last_episode_seen, total_episodes, status, score, remote_url, start_date, finish_date, private FROM anime_sync NOT INDEXED;

CREATE TEMP TABLE legacy_animesources AS SELECT _id, lang, name FROM animesources NOT INDEXED;

CREATE TEMP TABLE legacy_animehistory AS SELECT _id, episode_id, last_seen FROM animehistory NOT INDEXED;

CREATE INDEX migration_history_item ON legacy_animehistory(episode_id);

CREATE TEMP TABLE title_map(old_id INTEGER, keep_id INTEGER, precedence INTEGER, favorite INTEGER);

INSERT INTO title_map
SELECT _id AS old_id,
    first_value(_id) OVER (PARTITION BY source, url ORDER BY favorite DESC, _id),
    row_number() OVER (PARTITION BY source, url ORDER BY favorite DESC, _id),
    favorite
FROM legacy_animes;

CREATE UNIQUE INDEX migration_title_old ON title_map(old_id);

CREATE INDEX migration_title_keep ON title_map(keep_id, precedence);

CREATE INDEX migration_title_id ON legacy_animes(_id);

CREATE TEMP TABLE anime_type_guard(ok INTEGER CONSTRAINT anime_incompatible_fetch_types CHECK(ok = 1));

INSERT INTO anime_type_guard SELECT 0 FROM legacy_animes A JOIN title_map M ON M.old_id = A._id GROUP BY M.keep_id HAVING count(DISTINCT A.fetch_type) > 1;

CREATE TEMP TABLE parent_candidates AS SELECT DISTINCT M.keep_id AS child_id, P.keep_id AS parent_id
FROM legacy_animes A JOIN title_map M ON M.old_id = A._id JOIN title_map P ON P.old_id = A.parent_id;

CREATE TEMP TABLE anime_parent_guard(ok INTEGER CONSTRAINT anime_incompatible_parents CHECK(ok = 1));

INSERT INTO anime_parent_guard SELECT 0 FROM parent_candidates GROUP BY child_id HAVING count(*) > 1;

CREATE TEMP TABLE anime_cycle_guard(ok INTEGER CONSTRAINT anime_parent_cycle CHECK(ok = 1));

CREATE UNIQUE INDEX migration_parent_child ON parent_candidates(child_id);

CREATE INDEX migration_parent_parent ON parent_candidates(parent_id);

WITH RECURSIVE rooted(id) AS (
    SELECT keep_id FROM title_map WHERE old_id = keep_id AND keep_id NOT IN (SELECT child_id FROM parent_candidates)
    UNION ALL
    SELECT P.child_id FROM parent_candidates P JOIN rooted R ON P.parent_id = R.id
)
INSERT INTO anime_cycle_guard SELECT 0 WHERE (SELECT count(*) FROM rooted) != (SELECT count(*) FROM title_map WHERE old_id = keep_id);

CREATE TEMP TABLE item_map(old_id INTEGER, title_id INTEGER, keep_id INTEGER);

INSERT INTO item_map
SELECT C._id AS old_id, M.keep_id AS title_id,
    first_value(C._id) OVER (PARTITION BY M.keep_id, C.url
        ORDER BY EXISTS(SELECT 1 FROM legacy_animehistory H WHERE H.episode_id = C._id) DESC, C._id)
FROM legacy_episodes C JOIN title_map M ON M.old_id = C.anime_id;

CREATE UNIQUE INDEX migration_item_old ON item_map(old_id);

CREATE INDEX migration_item_keep ON item_map(keep_id);

CREATE INDEX migration_item_id ON legacy_episodes(_id);

DROP VIEW animedeletableView;

DROP VIEW animehistoryView;

DROP VIEW animehistorystatsView;

DROP VIEW animelibView;

DROP VIEW animeseasonsView;

DROP VIEW animeseasonstatsView;

DROP VIEW animeupdatesView;

DROP VIEW episodestatsView;

DROP TABLE animehistory;

DROP TABLE animes_categories;

DROP TABLE anime_sync;

DROP TABLE episodes;

DROP TABLE animes;

DROP TABLE categories;

DROP TABLE animesources;

CREATE TABLE anime(
    id INTEGER NOT NULL PRIMARY KEY,
    source_id INTEGER NOT NULL,
    remote_url TEXT NOT NULL,
    remote_artist TEXT,
    remote_author TEXT,
    remote_description TEXT,
    remote_genre TEXT,
    remote_title TEXT NOT NULL,
    remote_status INTEGER NOT NULL,
    remote_cover TEXT,
    favorite INTEGER NOT NULL,
    state_last_update INTEGER,
    state_next_update INTEGER,
    state_initialized INTEGER NOT NULL,
    user_viewer INTEGER NOT NULL,
    user_episode_flags INTEGER NOT NULL,
    state_cover_last_modified INTEGER NOT NULL,
    date_added INTEGER NOT NULL,
    remote_update_strategy INTEGER NOT NULL DEFAULT 0,
    state_fetch_interval INTEGER DEFAULT 0 NOT NULL,
    last_modified_at INTEGER NOT NULL DEFAULT 0,
    favorite_modified_at INTEGER,
    version INTEGER NOT NULL DEFAULT 0,
    is_syncing INTEGER NOT NULL DEFAULT 0,
    remote_fetch_type INTEGER NOT NULL DEFAULT 1,
    parent_id INTEGER,
    user_season_flags INTEGER NOT NULL,
    remote_season_number REAL NOT NULL,
    remote_season_source_order INTEGER NOT NULL,
    remote_background TEXT,
    state_background_last_modified INTEGER NOT NULL,
    UNIQUE(source_id, remote_url)
);

CREATE INDEX animelib_favorite_index ON anime(favorite) WHERE favorite = 1;

CREATE INDEX animes_url_index ON anime(remote_url);

CREATE INDEX animes_parent_id ON anime(parent_id);

CREATE INDEX animes_fetch_type ON anime(remote_fetch_type);

CREATE TABLE anime_category(
    id INTEGER NOT NULL PRIMARY KEY,
    anime_id INTEGER NOT NULL,
    category_id INTEGER NOT NULL,
    UNIQUE(anime_id, category_id),
    FOREIGN KEY(category_id) REFERENCES category (id)
    ON DELETE CASCADE,
    FOREIGN KEY(anime_id) REFERENCES anime (id)
    ON DELETE CASCADE
);

CREATE TABLE anime_history(
    id INTEGER NOT NULL PRIMARY KEY,
    episode_id INTEGER NOT NULL UNIQUE,
    last_seen INTEGER,
    FOREIGN KEY(episode_id) REFERENCES episode (id)
    ON DELETE CASCADE
);

CREATE INDEX animehistory_history_episode_id_index ON anime_history(episode_id);

CREATE INDEX anime_history_date_index ON anime_history(last_seen DESC);

CREATE TABLE anime_track(
    id INTEGER NOT NULL PRIMARY KEY,
    anime_id INTEGER NOT NULL,
    sync_id INTEGER NOT NULL,
    remote_id INTEGER NOT NULL,
    library_id INTEGER,
    title TEXT NOT NULL,
    last_episode_seen REAL NOT NULL,
    total_episodes INTEGER NOT NULL,
    status INTEGER NOT NULL,
    score REAL NOT NULL,
    remote_url TEXT NOT NULL,
    start_date INTEGER NOT NULL,
    finish_date INTEGER NOT NULL,
    private INTEGER DEFAULT 0 NOT NULL,
    UNIQUE (anime_id, sync_id),
    FOREIGN KEY(anime_id) REFERENCES anime (id)
    ON DELETE CASCADE
);

CREATE TABLE category(
    id INTEGER NOT NULL PRIMARY KEY,
    name TEXT NOT NULL,
    sort INTEGER NOT NULL,
    flags INTEGER NOT NULL,
    hidden INTEGER NOT NULL DEFAULT 0
);

CREATE TABLE episode(
    id INTEGER NOT NULL PRIMARY KEY,
    anime_id INTEGER NOT NULL,
    remote_url TEXT NOT NULL,
    remote_name TEXT NOT NULL,
    remote_scanlator TEXT,
    user_seen INTEGER NOT NULL,
    user_bookmark INTEGER NOT NULL,
    user_last_second_seen INTEGER NOT NULL,
    remote_total_seconds INTEGER NOT NULL,
    remote_episode_number REAL NOT NULL,
    remote_source_order INTEGER NOT NULL,
    state_date_fetch INTEGER NOT NULL,
    remote_date_upload INTEGER NOT NULL,
    last_modified_at INTEGER NOT NULL DEFAULT 0,
    version INTEGER NOT NULL DEFAULT 0,
    is_syncing INTEGER NOT NULL DEFAULT 0,
    remote_summary TEXT,
    remote_preview TEXT,
    user_fillermark INTEGER NOT NULL,
    UNIQUE(anime_id, remote_url),
    FOREIGN KEY(anime_id) REFERENCES anime (id)
    ON DELETE CASCADE
);

CREATE INDEX episodes_anime_id_index ON episode(anime_id);

CREATE INDEX episodes_unseen_by_anime_index ON episode(anime_id, user_seen) WHERE user_seen = 0;

CREATE INDEX episode_fetch_date_index ON episode(state_date_fetch DESC);

CREATE TABLE source(
    id INTEGER NOT NULL PRIMARY KEY,
    lang TEXT NOT NULL,
    name TEXT NOT NULL
);

CREATE TEMP TABLE migration_blank_characters(value TEXT NOT NULL);

INSERT INTO migration_blank_characters VALUES (char(9, 10, 11, 12, 13, 28, 29, 30, 31, 32, 160, 5760, 8192, 8193, 8194, 8195, 8196, 8197, 8198, 8199, 8200, 8201, 8202, 8232, 8233, 8239, 8287, 12288));

INSERT INTO anime(id, source_id, remote_url, remote_artist, remote_author, remote_description, remote_genre, remote_title, remote_status, remote_cover, favorite, state_last_update, state_next_update, state_initialized, user_viewer, user_episode_flags, state_cover_last_modified, date_added, remote_update_strategy, state_fetch_interval, last_modified_at, favorite_modified_at, version, is_syncing, remote_fetch_type, parent_id, user_season_flags, remote_season_number, remote_season_source_order, remote_background, state_background_last_modified)
SELECT
    T._id,
    T.source,
    T.url,
    (SELECT D.artist FROM legacy_animes D JOIN title_map DM ON DM.old_id = D._id WHERE DM.keep_id = T._id AND D.artist IS NOT NULL ORDER BY trim(D.artist, (SELECT value FROM migration_blank_characters)) = '', DM.precedence LIMIT 1),
    (SELECT D.author FROM legacy_animes D JOIN title_map DM ON DM.old_id = D._id WHERE DM.keep_id = T._id AND D.author IS NOT NULL ORDER BY trim(D.author, (SELECT value FROM migration_blank_characters)) = '', DM.precedence LIMIT 1),
    (SELECT D.description FROM legacy_animes D JOIN title_map DM ON DM.old_id = D._id WHERE DM.keep_id = T._id AND D.description IS NOT NULL ORDER BY trim(D.description, (SELECT value FROM migration_blank_characters)) = '', DM.precedence LIMIT 1),
    (SELECT D.genre FROM legacy_animes D JOIN title_map DM ON DM.old_id = D._id WHERE DM.keep_id = T._id AND D.genre IS NOT NULL ORDER BY trim(D.genre, (SELECT value FROM migration_blank_characters)) = '', DM.precedence LIMIT 1),
    T.title,
    T.status,
    (SELECT D.thumbnail_url FROM legacy_animes D JOIN title_map DM ON DM.old_id = D._id WHERE DM.keep_id = T._id AND D.thumbnail_url IS NOT NULL ORDER BY trim(D.thumbnail_url, (SELECT value FROM migration_blank_characters)) = '', DM.precedence LIMIT 1),
    T.favorite,
    (SELECT max(D.last_update) FROM legacy_animes D JOIN title_map DM ON DM.old_id = D._id WHERE DM.keep_id = T._id),
    T.next_update,
    (SELECT max(D.initialized) FROM legacy_animes D JOIN title_map DM ON DM.old_id = D._id WHERE DM.keep_id = T._id),
    T.viewer,
    T.episode_flags,
    (SELECT max(D.cover_last_modified) FROM legacy_animes D JOIN title_map DM ON DM.old_id = D._id WHERE DM.keep_id = T._id),
    CASE WHEN T.favorite = 1 THEN coalesce((SELECT min(nullif(D.date_added, 0)) FROM legacy_animes D JOIN title_map DM ON DM.old_id = D._id WHERE DM.keep_id = T._id AND D.favorite = 1), 0) ELSE T.date_added END,
    T.update_strategy,
    T.calculate_interval,
    (SELECT max(D.last_modified_at) FROM legacy_animes D JOIN title_map DM ON DM.old_id = D._id WHERE DM.keep_id = T._id),
    (SELECT max(D.favorite_modified_at) FROM legacy_animes D JOIN title_map DM ON DM.old_id = D._id WHERE DM.keep_id = T._id),
    T.version,
    T.is_syncing,
    T.fetch_type,
    (SELECT P.parent_id FROM parent_candidates P WHERE P.child_id = T._id),
    T.season_flags,
    T.season_number,
    T.season_source_order,
    (SELECT D.background_url FROM legacy_animes D JOIN title_map DM ON DM.old_id = D._id WHERE DM.keep_id = T._id AND D.background_url IS NOT NULL ORDER BY trim(D.background_url, (SELECT value FROM migration_blank_characters)) = '', DM.precedence LIMIT 1),
    (SELECT max(D.background_last_modified) FROM legacy_animes D JOIN title_map DM ON DM.old_id = D._id WHERE DM.keep_id = T._id)
FROM legacy_animes T JOIN title_map M ON M.old_id = T._id AND M.keep_id = T._id;

INSERT INTO episode(id, anime_id, remote_url, remote_name, remote_scanlator, user_seen, user_bookmark, user_last_second_seen, remote_total_seconds, remote_episode_number, remote_source_order, state_date_fetch, remote_date_upload, last_modified_at, version, is_syncing, remote_summary, remote_preview, user_fillermark)
SELECT
    C._id,
    M.title_id,
    C.url,
    C.name,
    (SELECT D.scanlator FROM legacy_episodes D JOIN item_map DM ON DM.old_id = D._id WHERE DM.keep_id = C._id AND D.scanlator IS NOT NULL ORDER BY trim(D.scanlator, (SELECT value FROM migration_blank_characters)) = '', (DM.old_id = DM.keep_id) DESC, D._id LIMIT 1),
    (SELECT max(D.seen) FROM legacy_episodes D JOIN item_map DM ON DM.old_id = D._id WHERE DM.keep_id = C._id),
    (SELECT max(D.bookmark) FROM legacy_episodes D JOIN item_map DM ON DM.old_id = D._id WHERE DM.keep_id = C._id),
    (SELECT max(D.last_second_seen) FROM legacy_episodes D JOIN item_map DM ON DM.old_id = D._id WHERE DM.keep_id = C._id),
    (SELECT max(D.total_seconds) FROM legacy_episodes D JOIN item_map DM ON DM.old_id = D._id WHERE DM.keep_id = C._id),
    C.episode_number,
    C.source_order,
    coalesce((SELECT min(nullif(D.date_fetch, 0)) FROM legacy_episodes D JOIN item_map DM ON DM.old_id = D._id WHERE DM.keep_id = C._id), 0),
    (SELECT max(D.date_upload) FROM legacy_episodes D JOIN item_map DM ON DM.old_id = D._id WHERE DM.keep_id = C._id),
    (SELECT max(D.last_modified_at) FROM legacy_episodes D JOIN item_map DM ON DM.old_id = D._id WHERE DM.keep_id = C._id),
    C.version,
    C.is_syncing,
    (SELECT D.summary FROM legacy_episodes D JOIN item_map DM ON DM.old_id = D._id WHERE DM.keep_id = C._id AND D.summary IS NOT NULL ORDER BY trim(D.summary, (SELECT value FROM migration_blank_characters)) = '', (DM.old_id = DM.keep_id) DESC, D._id LIMIT 1),
    (SELECT D.preview_url FROM legacy_episodes D JOIN item_map DM ON DM.old_id = D._id WHERE DM.keep_id = C._id AND D.preview_url IS NOT NULL ORDER BY trim(D.preview_url, (SELECT value FROM migration_blank_characters)) = '', (DM.old_id = DM.keep_id) DESC, D._id LIMIT 1),
    (SELECT max(D.fillermark) FROM legacy_episodes D JOIN item_map DM ON DM.old_id = D._id WHERE DM.keep_id = C._id)
FROM legacy_episodes C JOIN item_map M ON M.old_id = C._id AND M.keep_id = C._id;

CREATE TABLE download_queue_alias(
    old_parent_id INTEGER NOT NULL,
    old_item_id INTEGER NOT NULL,
    item_id INTEGER,
    PRIMARY KEY(old_parent_id, old_item_id),
    FOREIGN KEY(item_id) REFERENCES episode (id) ON DELETE SET NULL
);

INSERT INTO download_queue_alias
SELECT C.anime_id, C._id, M.keep_id
FROM legacy_episodes C LEFT JOIN item_map M ON M.old_id = C._id;

INSERT INTO anime_history(id, episode_id, last_seen)
SELECT
    min(H._id),
    M.keep_id,
    max(H.last_seen)
FROM legacy_animehistory H JOIN item_map M ON M.old_id = H.episode_id GROUP BY M.keep_id;

INSERT INTO category(id, name, sort, flags, hidden)
SELECT
    C._id,
    C.name,
    CASE WHEN C._id = 0 THEN -1 ELSE row_number() OVER (PARTITION BY C._id = 0 ORDER BY C.sort, C._id) - 1 END,
    C.flags,
    C.hidden
FROM legacy_categories C;

INSERT INTO category(id, name, sort, flags, hidden) VALUES (0, '', -1, 0, 0) ON CONFLICT(id) DO NOTHING;

-- Removed titles keep their categories; library groups only inherit memberships from favorite copies.
INSERT INTO anime_category(id, anime_id, category_id)
SELECT
    min(C._id),
    M.keep_id,
    C.category_id
FROM legacy_animes_categories C JOIN title_map M ON M.old_id = C.anime_id
JOIN legacy_categories K ON K._id = C.category_id
JOIN anime T ON T.id = M.keep_id
WHERE M.favorite = 1 OR T.favorite = 0
GROUP BY M.keep_id, C.category_id;

CREATE TEMP TABLE track_map(_id INTEGER, keep_id INTEGER, precedence INTEGER);

INSERT INTO track_map SELECT S._id, M.keep_id, row_number() OVER (PARTITION BY M.keep_id, S.sync_id ORDER BY M.favorite DESC, S.last_episode_seen DESC, M.precedence, S._id) FROM legacy_anime_sync S JOIN title_map M ON M.old_id = S.anime_id;

INSERT INTO anime_track(id, anime_id, sync_id, remote_id, library_id, title, last_episode_seen, total_episodes, status, score, remote_url, start_date, finish_date, private)
SELECT
    S._id,
    M.keep_id,
    S.sync_id,
    S.remote_id,
    S.library_id,
    S.title,
    S.last_episode_seen,
    S.total_episodes,
    S.status,
    S.score,
    S.remote_url,
    S.start_date,
    S.finish_date,
    S.private
FROM legacy_anime_sync S JOIN track_map M ON M._id = S._id WHERE M.precedence = 1;

INSERT INTO source(id, lang, name)
SELECT
    S._id,
    S.lang,
    S.name
FROM legacy_animesources S;

CREATE TRIGGER update_last_favorite_at_animes
AFTER UPDATE OF favorite ON anime
BEGIN
  UPDATE anime
  SET favorite_modified_at = strftime('%s', 'now')
  WHERE id = new.id;
END;

CREATE TRIGGER update_last_modified_at_animes
AFTER UPDATE ON anime
FOR EACH ROW
BEGIN
  UPDATE anime
  SET last_modified_at = strftime('%s', 'now')
  WHERE id = new.id;
END;

CREATE TRIGGER update_anime_version AFTER UPDATE ON anime
BEGIN
    UPDATE anime SET version = version + 1
    WHERE id = new.id AND new.is_syncing = 0 AND (
        new.remote_url != old.remote_url OR
        new.remote_description != old.remote_description OR
        new.favorite != old.favorite
    );
END;

CREATE TRIGGER insert_anime_category_update_version AFTER INSERT ON anime_category
BEGIN
    UPDATE anime
    SET version = version + 1
    WHERE id = new.anime_id AND (SELECT is_syncing FROM anime WHERE id = new.anime_id) = 0;
END;

-- Disallow deletion of default category
CREATE TRIGGER IF NOT EXISTS system_category_delete_trigger BEFORE DELETE
ON category
BEGIN SELECT CASE
    WHEN old.id <= 0 THEN
        RAISE(ABORT, "System category can't be deleted")
    END;
END;

CREATE TRIGGER update_last_modified_at_episodes
AFTER UPDATE ON episode
FOR EACH ROW
BEGIN
  UPDATE episode
  SET last_modified_at = strftime('%s', 'now')
  WHERE id = new.id;
END;

CREATE TRIGGER update_episode_and_anime_version AFTER UPDATE ON episode
WHEN new.is_syncing = 0 AND (
    new.user_seen != old.user_seen OR
    new.user_bookmark != old.user_bookmark OR
    new.user_last_second_seen != old.user_last_second_seen
)
BEGIN
    -- Update the episode version
    UPDATE episode SET version = version + 1
    WHERE id = new.id;

    -- Update the anime version
    UPDATE anime SET version = version + 1
    WHERE id = new.anime_id AND (SELECT is_syncing FROM anime WHERE id = new.anime_id) = 0;
END;

CREATE VIEW animedeletableView AS
SELECT
    M.id AS _id,
    M.source_id AS source,
    M.remote_fetch_type AS fetch_type
FROM anime AS M
WHERE M.favorite = 0
AND M.parent_id IS NULL;

CREATE VIEW animehistoryView AS
SELECT
    anime_history.id AS id,
    anime.id AS animeId,
    episode.id AS episodeId,
    anime.remote_title AS title,
    anime.remote_cover AS thumbnailUrl,
    anime.source_id AS source,
    anime.favorite AS favorite,
    anime.state_cover_last_modified AS cover_last_modified,
    episode.remote_episode_number AS episodeNumber,
    anime_history.last_seen AS seenAt,
    max_last_seen.last_seen AS maxSeenAt,
    max_last_seen.episode_id AS maxSeenAtEpisodeId
FROM anime
JOIN episode
ON anime.id = episode.anime_id
JOIN anime_history
ON episode.id = anime_history.episode_id
JOIN (
    SELECT episode.anime_id,episode.id AS episode_id, MAX(anime_history.last_seen) AS last_seen
    FROM episode JOIN anime_history
    ON episode.id = anime_history.episode_id
    GROUP BY episode.anime_id
) AS max_last_seen
ON episode.anime_id = max_last_seen.anime_id;

CREATE VIEW animehistorystatsView AS
SELECT
    episode.anime_id AS anime_id,
    max(ah.last_seen) AS lastSeen
FROM episode
LEFT JOIN anime_history AS ah ON episode.id = ah.episode_id
GROUP BY episode.anime_id;

CREATE VIEW animeLibraryRelevantView AS

    SELECT id FROM anime WHERE favorite = 1
    UNION
    SELECT C.id FROM anime C JOIN anime P ON P.id = C.parent_id
    WHERE P.favorite = 1 AND P.remote_fetch_type = 0
;

CREATE VIEW animeLibraryEpisodeStatsView AS

    SELECT
        EP.anime_id,
        count(*) AS total,
        sum(EP.user_seen) AS seenCount,
        max(EP.remote_date_upload) AS latestUpload,
        max(EP.state_date_fetch) AS fetchedAt,
        sum(EP.user_bookmark) AS bookmarkCount,
        sum(EP.user_fillermark) AS fillermarkCount
    FROM episode EP
    WHERE EP.anime_id IN (SELECT id FROM animeLibraryRelevantView)
    GROUP BY EP.anime_id
;

CREATE VIEW animeLibraryHistoryStatsView AS

    SELECT EP.anime_id, max(H.last_seen) AS lastSeen
    FROM anime_history H JOIN episode EP ON EP.id = H.episode_id
    WHERE EP.anime_id IN (SELECT id FROM animeLibraryRelevantView)
    GROUP BY EP.anime_id
;

CREATE VIEW animeLibrarySeasonStatsView AS

    SELECT
        C.parent_id,
        count(*) AS child_count,
        sum(CASE WHEN C.remote_fetch_type = 1 AND coalesce(ES.total, 0) = coalesce(ES.seenCount, 0)
            THEN 1 ELSE 0 END) AS fully_seen_seasons,
        max(ES.latestUpload) AS max_latest_upload,
        max(ES.fetchedAt) AS max_fetched_at,
        max(HS.lastSeen) AS max_last_seen,
        sum(ES.bookmarkCount) AS total_bookmarks,
        sum(ES.fillermarkCount) AS total_fillermarks
    FROM anime C
    LEFT JOIN animeLibraryEpisodeStatsView ES ON ES.anime_id = C.id
    LEFT JOIN animeLibraryHistoryStatsView HS ON HS.anime_id = C.id
    WHERE C.parent_id IN (SELECT id FROM anime WHERE favorite = 1 AND remote_fetch_type = 0)
    GROUP BY C.parent_id
;

CREATE VIEW animelibView AS
SELECT
    M.*,
    CASE M.remote_fetch_type
        WHEN 1 THEN coalesce(ES.total, 0)
        WHEN 0 THEN coalesce(SS.child_count, 0)
    END AS totalCount,
    CASE M.remote_fetch_type
        WHEN 1 THEN coalesce(ES.seenCount, 0)
        WHEN 0 THEN coalesce(SS.fully_seen_seasons, 0)
    END AS seenCount,
    CASE M.remote_fetch_type
        WHEN 1 THEN coalesce(ES.latestUpload, 0)
        WHEN 0 THEN coalesce(SS.max_latest_upload, 0)
    END AS latestUpload,
    CASE M.remote_fetch_type
        WHEN 1 THEN coalesce(ES.fetchedAt, 0)
        WHEN 0 THEN coalesce(SS.max_fetched_at, 0)
    END AS episodeFetchedAt,
    CASE M.remote_fetch_type
        WHEN 1 THEN coalesce(HS.lastSeen, 0)
        WHEN 0 THEN coalesce(SS.max_last_seen, 0)
    END AS lastSeen,
    CASE M.remote_fetch_type
        WHEN 1 THEN coalesce(ES.bookmarkCount, 0)
        WHEN 0 THEN coalesce(SS.total_bookmarks, 0)
    END AS bookmarkCount,
    CASE M.remote_fetch_type
        WHEN 1 THEN coalesce(ES.fillermarkCount, 0)
        WHEN 0 THEN coalesce(SS.total_fillermarks, 0)
    END AS fillermarkCount,
    coalesce((
        SELECT group_concat(category_id)
        FROM (
            SELECT AC.category_id
            FROM anime_category AC JOIN category CAT ON CAT.id = AC.category_id
            WHERE AC.anime_id = M.id
            ORDER BY CAT.sort, CAT.id
        )
    ), '0') AS categories
FROM anime M
LEFT JOIN animeLibraryEpisodeStatsView ES ON ES.anime_id = M.id
LEFT JOIN animeLibraryHistoryStatsView HS ON HS.anime_id = M.id
LEFT JOIN animeLibrarySeasonStatsView SS ON SS.parent_id = M.id
WHERE M.favorite = 1;

CREATE VIEW animeseasonsView AS
SELECT
    M.*,
    CASE M.remote_fetch_type
        WHEN 1 THEN coalesce(ES.total, 0)
        WHEN 0 THEN coalesce(ASS.child_count, 0)
    END AS totalCount,
    CASE M.remote_fetch_type
        WHEN 1 THEN coalesce(ES.seenCount, 0)
        WHEN 0 THEN coalesce(ASS.fully_seen_seasons, 0)
    END AS seenCount,
    CASE M.remote_fetch_type
        WHEN 1 THEN coalesce(ES.latestUpload, 0)
        WHEN 0 THEN coalesce(ASS.max_latest_upload, 0)
    END AS latestUpload,
    CASE M.remote_fetch_type
        WHEN 1 THEN coalesce(ES.fetchedAt, 0)
        WHEN 0 THEN coalesce(ASS.max_fetched_at, 0)
    END AS episodeFetchedAt,
    CASE M.remote_fetch_type
        WHEN 1 THEN coalesce(AHS.lastSeen, 0)
        WHEN 0 THEN coalesce(ASS.max_last_seen, 0)
    END AS lastSeen,
    CASE M.remote_fetch_type
        WHEN 1 THEN coalesce(ES.bookmarkCount, 0)
        WHEN 0 THEN coalesce(ASS.total_bookmarks, 0)
    END AS bookmarkCount,
    CASE M.remote_fetch_type
        WHEN 1 THEN coalesce(ES.fillermarkCount, 0)
        WHEN 0 THEN coalesce(ASS.total_fillermarks, 0)
    END AS fillermarkCount
FROM anime AS M
LEFT JOIN episodestatsView AS ES
ON M.id = ES.anime_id
LEFT JOIN animehistorystatsView AS AHS
ON M.id = AHS.anime_id
LEFT JOIN animeseasonstatsView AS ASS
ON M.id = ASS.parent_id
WHERE M.parent_id IS NOT NULL;

CREATE VIEW animeseasonstatsView AS
SELECT
    season.parent_id AS parent_id,
    count(*) AS child_count,
    sum(CASE WHEN season.remote_fetch_type = 1 AND
                 coalesce(ES.total, 0) = coalesce(ES.seenCount, 0)
            THEN 1 ELSE 0 END) AS fully_seen_seasons,
    max(coalesce(ES.latestUpload, 0)) AS max_latest_upload,
    max(coalesce(ES.fetchedAt, 0)) AS max_fetched_at,
    max(coalesce(AHS.lastSeen, 0)) AS max_last_seen,
    sum(coalesce(ES.bookmarkCount, 0)) AS total_bookmarks,
    sum(coalesce(ES.fillermarkCount, 0)) AS total_fillermarks
FROM anime season
LEFT JOIN episodestatsView ES ON season.id = ES.anime_id
LEFT JOIN animehistorystatsView AHS ON season.id = AHS.anime_id
WHERE season.parent_id IS NOT NULL
GROUP BY season.parent_id;

CREATE VIEW animeupdatesView AS
SELECT
    anime.id AS animeId,
    anime.remote_title AS animeTitle,
    episode.id AS episodeId,
    episode.remote_name AS episodeName,
    episode.remote_scanlator AS scanlator,
    episode.user_seen AS seen,
    episode.user_bookmark AS bookmark,
    episode.user_fillermark AS fillermark,
    episode.user_last_second_seen AS last_second_seen,
    episode.remote_total_seconds AS totalSeconds,
    anime.source_id AS source,
    anime.favorite AS favorite,
    anime.remote_cover AS thumbnailUrl,
    anime.state_cover_last_modified AS coverLastModified,
    episode.remote_date_upload AS dateUpload,
    episode.state_date_fetch AS datefetch
FROM anime JOIN episode
ON anime.id = episode.anime_id
WHERE favorite = 1
AND state_date_fetch > date_added
ORDER BY state_date_fetch DESC;

CREATE VIEW episodestatsView AS
SELECT
    episode.anime_id AS anime_id,
    count(*) AS total,
    sum(user_seen) AS seenCount,
    coalesce(max(episode.remote_date_upload), 0) AS latestUpload,
    coalesce(max(episode.state_date_fetch), 0) AS fetchedAt,
    sum(episode.user_bookmark) AS bookmarkCount,
    sum(episode.user_fillermark) AS fillermarkCount
FROM episode
GROUP BY episode.anime_id;

