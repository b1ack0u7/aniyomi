CREATE VIEW animehistoryView AS
SELECT
    anime_history.id AS id,
    anime.id AS animeId,
    episode.id AS episodeId,
    anime.remote_title AS title,
    anime.remote_cover AS thumbnailUrl,
    anime.source_id AS source,
    anime.favorite AS favorite,
    anime.state_cover_last_modified AS cover_last_modified,
    episode.remote_episode_number AS episodeNumber,
    anime_history.last_seen AS seenAt,
    max_last_seen.last_seen AS maxSeenAt,
    max_last_seen.episode_id AS maxSeenAtEpisodeId
FROM anime
JOIN episode
ON anime.id = episode.anime_id
JOIN anime_history
ON episode.id = anime_history.episode_id
JOIN (
    SELECT episode.anime_id,episode.id AS episode_id, MAX(anime_history.last_seen) AS last_seen
    FROM episode JOIN anime_history
    ON episode.id = anime_history.episode_id
    GROUP BY episode.anime_id
) AS max_last_seen
ON episode.anime_id = max_last_seen.anime_id;

animehistory:
SELECT
id,
animeId,
episodeId,
title,
thumbnailUrl,
source,
favorite,
cover_last_modified,
episodeNumber,
seenAt
FROM animehistoryView
WHERE animehistoryView.seenAt > 0
AND maxSeenAtEpisodeId = animehistoryView.episodeId
AND lower(animehistoryView.title) LIKE ('%' || :query || '%')
ORDER BY seenAt DESC;

getLatestAnimeHistory:
SELECT
id,
animeId,
episodeId,
title,
thumbnailUrl,
source,
favorite,
cover_last_modified,
episodeNumber,
seenAt
FROM animehistoryView
WHERE animehistoryView.seenAt > 0
ORDER BY seenAt DESC
LIMIT 1;
