CREATE VIEW animeLibraryRelevantView AS

    SELECT id FROM anime WHERE favorite = 1
    UNION
    SELECT C.id FROM anime C JOIN anime P ON P.id = C.parent_id
    WHERE P.favorite = 1 AND P.remote_fetch_type = 0
;

CREATE VIEW animeLibraryEpisodeStatsView AS

    SELECT
        EP.anime_id,
        count(*) AS total,
        sum(EP.user_seen) AS seenCount,
        max(EP.remote_date_upload) AS latestUpload,
        max(EP.state_date_fetch) AS fetchedAt,
        sum(EP.user_bookmark) AS bookmarkCount,
        sum(EP.user_fillermark) AS fillermarkCount
    FROM episode EP
    WHERE EP.anime_id IN (SELECT id FROM animeLibraryRelevantView)
    GROUP BY EP.anime_id
;

CREATE VIEW animeLibraryHistoryStatsView AS

    SELECT EP.anime_id, max(H.last_seen) AS lastSeen
    FROM anime_history H JOIN episode EP ON EP.id = H.episode_id
    WHERE EP.anime_id IN (SELECT id FROM animeLibraryRelevantView)
    GROUP BY EP.anime_id
;

CREATE VIEW animeLibrarySeasonStatsView AS

    SELECT
        C.parent_id,
        count(*) AS child_count,
        sum(CASE WHEN C.remote_fetch_type = 1 AND coalesce(ES.total, 0) = coalesce(ES.seenCount, 0)
            THEN 1 ELSE 0 END) AS fully_seen_seasons,
        max(ES.latestUpload) AS max_latest_upload,
        max(ES.fetchedAt) AS max_fetched_at,
        max(HS.lastSeen) AS max_last_seen,
        sum(ES.bookmarkCount) AS total_bookmarks,
        sum(ES.fillermarkCount) AS total_fillermarks
    FROM anime C
    LEFT JOIN animeLibraryEpisodeStatsView ES ON ES.anime_id = C.id
    LEFT JOIN animeLibraryHistoryStatsView HS ON HS.anime_id = C.id
    WHERE C.parent_id IN (SELECT id FROM anime WHERE favorite = 1 AND remote_fetch_type = 0)
    GROUP BY C.parent_id
;

CREATE VIEW animelibView AS
SELECT
    M.*,
    CASE M.remote_fetch_type
        WHEN 1 THEN coalesce(ES.total, 0)
        WHEN 0 THEN coalesce(SS.child_count, 0)
    END AS totalCount,
    CASE M.remote_fetch_type
        WHEN 1 THEN coalesce(ES.seenCount, 0)
        WHEN 0 THEN coalesce(SS.fully_seen_seasons, 0)
    END AS seenCount,
    CASE M.remote_fetch_type
        WHEN 1 THEN coalesce(ES.latestUpload, 0)
        WHEN 0 THEN coalesce(SS.max_latest_upload, 0)
    END AS latestUpload,
    CASE M.remote_fetch_type
        WHEN 1 THEN coalesce(ES.fetchedAt, 0)
        WHEN 0 THEN coalesce(SS.max_fetched_at, 0)
    END AS episodeFetchedAt,
    CASE M.remote_fetch_type
        WHEN 1 THEN coalesce(HS.lastSeen, 0)
        WHEN 0 THEN coalesce(SS.max_last_seen, 0)
    END AS lastSeen,
    CASE M.remote_fetch_type
        WHEN 1 THEN coalesce(ES.bookmarkCount, 0)
        WHEN 0 THEN coalesce(SS.total_bookmarks, 0)
    END AS bookmarkCount,
    CASE M.remote_fetch_type
        WHEN 1 THEN coalesce(ES.fillermarkCount, 0)
        WHEN 0 THEN coalesce(SS.total_fillermarks, 0)
    END AS fillermarkCount,
    coalesce((
        SELECT group_concat(category_id)
        FROM (
            SELECT AC.category_id
            FROM anime_category AC JOIN category CAT ON CAT.id = AC.category_id
            WHERE AC.anime_id = M.id
            ORDER BY CAT.sort, CAT.id
        )
    ), '0') AS categories
FROM anime M
LEFT JOIN animeLibraryEpisodeStatsView ES ON ES.anime_id = M.id
LEFT JOIN animeLibraryHistoryStatsView HS ON HS.anime_id = M.id
LEFT JOIN animeLibrarySeasonStatsView SS ON SS.parent_id = M.id
WHERE M.favorite = 1;

animelib:
SELECT * FROM animelibView;
