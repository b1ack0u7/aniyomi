import kotlin.Boolean;
import kotlinx.serialization.json.JsonObject;

CREATE TABLE chapter(
    id INTEGER NOT NULL PRIMARY KEY,
    manga_id INTEGER NOT NULL,
    remote_url TEXT NOT NULL,
    remote_name TEXT NOT NULL,
    remote_scanlator TEXT,
    user_read INTEGER AS Boolean NOT NULL,
    user_bookmark INTEGER AS Boolean NOT NULL,
    user_last_page_read INTEGER NOT NULL,
    remote_chapter_number REAL NOT NULL,
    remote_source_order INTEGER NOT NULL,
    state_date_fetch INTEGER NOT NULL,
    remote_date_upload INTEGER NOT NULL,
    last_modified_at INTEGER NOT NULL DEFAULT 0,
    version INTEGER NOT NULL DEFAULT 0,
    is_syncing INTEGER NOT NULL DEFAULT 0,
    remote_memo BLOB AS JsonObject NOT NULL DEFAULT (CAST('{}' AS BLOB)),
    UNIQUE(manga_id, remote_url),
    FOREIGN KEY(manga_id) REFERENCES manga (id)
    ON DELETE CASCADE
);

CREATE INDEX chapters_manga_id_index ON chapter(manga_id);
CREATE INDEX chapters_unread_by_manga_index ON chapter(manga_id, user_read) WHERE user_read = 0;

CREATE TRIGGER update_last_modified_at_chapters
AFTER UPDATE ON chapter
FOR EACH ROW
BEGIN
  UPDATE chapter
  SET last_modified_at = strftime('%s', 'now')
  WHERE id = new.id;
END;

CREATE TRIGGER update_chapter_and_manga_version AFTER UPDATE ON chapter
WHEN new.is_syncing = 0 AND (
    new.user_read != old.user_read OR
    new.user_bookmark != old.user_bookmark OR
    new.user_last_page_read != old.user_last_page_read
)
BEGIN
    -- Update the chapter version
    UPDATE chapter SET version = version + 1
    WHERE id = new.id;

    -- Update the manga version
    UPDATE manga SET version = version + 1
    WHERE id = new.manga_id AND (SELECT is_syncing FROM manga WHERE id = new.manga_id) = 0;
END;

CREATE INDEX chapter_fetch_date_index ON chapter(state_date_fetch DESC);

getChapterById:
SELECT *
FROM chapter
WHERE id = :id;

getChaptersByMangaId:
SELECT C.*
FROM chapter C
LEFT JOIN excluded_scanlator ES
ON C.manga_id = ES.manga_id
AND C.remote_scanlator = ES.scanlator
WHERE C.manga_id = :mangaId
AND (
    :applyScanlatorFilter = 0
    OR ES.scanlator IS NULL
);

getScanlatorsByMangaId:
SELECT remote_scanlator
FROM chapter
WHERE manga_id = :mangaId;

getBookmarkedChaptersByMangaId:
SELECT *
FROM chapter
WHERE user_bookmark
AND manga_id = :mangaId;

getChapterByUrl:
SELECT *
FROM chapter
WHERE remote_url = :chapterUrl;

getChapterByUrlAndMangaId:
SELECT *
FROM chapter
WHERE remote_url = :chapterUrl
AND manga_id = :mangaId;

removeChaptersWithIds:
DELETE FROM chapter
WHERE id IN :chapterIds;

resetIsSyncing:
UPDATE chapter
SET is_syncing = 0
WHERE is_syncing = 1;

insert:
INSERT INTO chapter(manga_id, remote_url, remote_name, remote_scanlator, user_read, user_bookmark, user_last_page_read, remote_chapter_number, remote_source_order,state_date_fetch, remote_date_upload, last_modified_at, version, is_syncing, remote_memo)
VALUES (:mangaId, :url, :name, :scanlator, :read, :bookmark, :lastPageRead, :chapterNumber, :sourceOrder, :dateFetch, :dateUpload, 0, :version, 0, :memo)
ON CONFLICT(manga_id, remote_url) DO NOTHING;

update:
UPDATE chapter
SET manga_id = coalesce(:mangaId, manga_id),
    remote_url = coalesce(:url, remote_url),
    remote_name = coalesce(:name, remote_name),
    remote_scanlator = coalesce(:scanlator, remote_scanlator),
    user_read = coalesce(:read, user_read),
    user_bookmark = coalesce(:bookmark, user_bookmark),
    user_last_page_read = coalesce(:lastPageRead, user_last_page_read),
    remote_chapter_number = coalesce(:chapterNumber, remote_chapter_number),
    remote_source_order = coalesce(:sourceOrder, remote_source_order),
    state_date_fetch = coalesce(:dateFetch, state_date_fetch),
    remote_date_upload = coalesce(:dateUpload, remote_date_upload),
    version = coalesce(:version, version),
    is_syncing = coalesce(:isSyncing, is_syncing),
    remote_memo = coalesce(:memo, remote_memo)
WHERE id = :chapterId;

selectLastInsertedRowId:
SELECT last_insert_rowid();

getChaptersByMangaIds:
SELECT * FROM chapter
WHERE manga_id IN :mangaIds;

getExistingId:
SELECT id FROM chapter
WHERE manga_id = :titleId AND remote_url = :url;
